# Never commit live project data or client deliverables into the skills repo.
# Skills carry templates and logic only.
/_scratch/
/**/output/
/**/outputs/

# Redundant placeholders (each folder is kept by its README)
templates/skill-template/*/.gitkeep

# Build outputs — .plugin bundles are built from the release tag, not committed
/dist/
